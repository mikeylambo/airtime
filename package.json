    "capture": "node tools/capture.mjs",
    "gate": "node tools/gate-a.mjs",
    "probe:aero": "node tools/probe-aero.mjs",
    "probe:jump": "node tools/measure-jump.mjs",
    "probe:run": "node tools/probe-run.mjs",
    "probe:cars": "node tools/probe-cars.mjs",
    "probe:traffic": "node tools/probe-traffic.mjs",
    "probe:score": "node tools/probe-score.mjs",
    "shots": "node tools/shots.mjs",
    "shots:car": "node tools/car-shots.mjs",
    "probe:modes": "node tools/probe-modes.mjs",
    "gate:verbose": "node tools/gate-a.mjs --verbose",
    "probe:facets": "node tools/probe-facets.mjs",
    "probe:air": "node tools/probe-air.mjs",
    "probe:axes": "node tools/probe-axes.mjs",
    "probe:flow": "node tools/probe-flow.mjs",
