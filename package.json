    "probe:mastery": "node tools/probe-mastery.mjs",
    "probe:menus": "node tools/probe-menus.mjs",
    "lines:city": "node tools/lines.mjs --city",
    "gaps:city": "node tools/lines.mjs --city --emit-gaps",
    "probe:save": "node tools/probe-save.mjs"
