{
  "name": "airtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIRTIME \u2014 Rush 2049 stunt mode frame. Drive recklessly, hit a ramp, flail, stick the landing.",
  "scripts": {
    "dev": "vite --host",
